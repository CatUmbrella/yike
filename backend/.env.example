YIKE_DATA_DIR=/var/lib/yike
DATABASE_URL=sqlite:////var/lib/yike/yike.db
AGENT_TRACE_DB_PATH=/var/lib/yike/yike_agent_traces.db
AGENT_TRACE_ENABLED=true
CORS_ORIGINS=https://your-domain.example
API_TOKEN=replace-with-random-api-token
LOG_LEVEL=INFO
OPENAI_API_KEY=replace-with-server-secret
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
